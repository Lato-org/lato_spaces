<%= lato_page_head I18n.t('lato_spaces.spaces') do %>
  <p class="lead"><%= t('lato_spaces.welcome_html', user: @session.user.first_name) %></p>
<% end %>

<%= turbo_frame_tag 'index' do %>
  <%

    groups = @groups.map do |group|
      is_selected = @session.get(:spaces_group_id)&.to_i == group.id
      is_preferred = @memberships.find { |m| m.lato_spaces_group_id == group.id }&.preferred

      {
        id: group.id,
        name: group.name,
        is_selected: is_selected,
        is_preferred: is_preferred
      }
    end

    groups = groups.sort_by { |g| [g[:is_preferred] ? 0 : 1, g[:name].downcase] }
    can_create = @session.user.lato_spaces_admin || LatoSpaces.config.permit_group_creation
  %>

  <% if groups.empty? && !can_create %>
    <div class="alert alert-info" role="status"><%= I18n.t('lato_spaces.no_groups') %></div>
  <% end %>

  <div class="row">
    <% groups.each do |group| %>
      <div class="col-12 col-md-6 col-lg-4 col-xl-3 mb-3">
        <div class="card h-100 border border-4 <%= group[:is_selected] ? 'border-success' : 'border-light' %>" <%= 'aria-current="true"'.html_safe if group[:is_selected] %>>
          <div class="card-body">
            <div class="d-flex align-items-center justify-content-between d-lg-block">
              <div class="d-flex align-items-center d-lg-block text-center">
                <i class="<%= LatoSpaces.config.group_icon %> fs-1 me-2 me-lg-0" aria-hidden="true"></i><br>
                <span class="fw-bold"><%= group[:name] %></span>
                <% if group[:is_selected] %>
                  <span class="badge text-bg-success ms-1"><%= I18n.t('lato_spaces.selected') %></span>
                <% end %>
                <% if group[:is_preferred] && LatoSpaces.config.permit_group_preferred %>
                  <span class="badge text-bg-warning ms-1"><%= I18n.t('lato_spaces.preferred') %></span>
                <% end %>
              </div>
              <div class="d-flex justify-content-center align-items-center mt-lg-2">
                <% if @session.user.lato_spaces_admin || LatoSpaces.config.permit_group_management %>
                  <%= link_to lato_spaces.groups_show_path(group[:id]), class: "btn btn-light me-1", title: I18n.t('lato_spaces.aria.manage_group', name: group[:name]), aria: { label: I18n.t('lato_spaces.aria.manage_group', name: group[:name]) }, data: { turbo_frame: '_top' } do %>
                    <i class="bi bi-gear" aria-hidden="true"></i>
                  <% end %>
                <% end %>

                <% if LatoSpaces.config.permit_group_preferred %>
                  <%= button_to lato_spaces.setpreferred_path(group[:id]), class: "btn btn-#{group[:is_preferred] ? 'warning' : 'light'} ms-1 me-1", title: I18n.t('lato_spaces.aria.prefer_group', name: group[:name]), aria: { label: I18n.t('lato_spaces.aria.prefer_group', name: group[:name]), pressed: group[:is_preferred] ? 'true' : 'false' } do %>
                    <i class="bi bi-star<%= group[:is_preferred] ? '-fill' : '' %>" aria-hidden="true"></i>
                  <% end %>
                <% end %>

                <%= button_to lato_spaces.setgroup_path(group[:id]), class: "btn btn-#{group[:is_selected] ? 'success' : 'primary'} ms-1", form: { data: { turbo_frame: '_top' } }, title: I18n.t('lato_spaces.aria.select_group', name: group[:name]), aria: { label: I18n.t('lato_spaces.aria.select_group', name: group[:name]) } do %>
                  <i class="bi bi-check-circle<%= group[:is_selected] ? '-fill' : '' %>" aria-hidden="true"></i>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <% if @session.user.lato_spaces_admin %>
      <div class="col-12 col-md-6 col-lg-4 col-xl-3 mb-3">
        <%= link_to lato_spaces.groups_path, class: 'card border border-4 border-primary bg-primary text-white text-decoration-none h-100', data: { turbo_frame: '_top' } do %>
          <div class="card-body d-flex flex-column justify-content-center align-items-center">
            <div class="text-center">
              <i class="bi bi-sliders fs-1" aria-hidden="true"></i><br>
              <span class="fw-bold"><%= I18n.t('lato_spaces.cta_manage_groups') %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% elsif LatoSpaces.config.permit_group_creation %>
      <div class="col-12 col-md-6 col-lg-4 col-xl-3 mb-3">
        <%= link_to lato_spaces.groups_create_path, class: 'card border border-4 border-primary bg-primary text-white text-decoration-none h-100', data: { lato_action_target: 'trigger', turbo_frame: dom_id(LatoSpaces::Group.new, 'form'), action_title: I18n.t('lato_spaces.new_group') } do %>
          <div class="card-body d-flex flex-column justify-content-center align-items-center">
            <div class="text-center">
              <i class="bi bi-plus-circle fs-1" aria-hidden="true"></i><br>
              <span class="fw-bold"><%= I18n.t('lato_spaces.cta_new_group') %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
