<%# h: lato_page_head renders the title as raw HTML %>
<%= lato_page_head h(@group.name), lato_spaces_breadcrumbs %>

<div class="card mb-4">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h2 class="fs-4 mb-0"><%= I18n.t('lato_spaces.group_informations') %></h2>
    <div class="d-flex gap-1">
      <%= button_to I18n.t('lato_spaces.cta_select'), lato_spaces.setgroup_path(@group), class: 'btn btn-sm btn-success', form: { data: { turbo_frame: '_top' } }, aria: { label: I18n.t('lato_spaces.aria.select_group', name: @group.name) } %>
      <div class="btn-group btn-group-sm" role="group">
        <%= link_to I18n.t('lato_spaces.cta_edit'), lato_spaces.groups_update_path(@group), class: 'btn btn-primary', data: { lato_action_target: 'trigger', turbo_frame: dom_id(@group, 'form'), action_title: I18n.t('lato_spaces.edit_group') } %>
        <%= link_to I18n.t('lato_spaces.cta_delete'), lato_spaces.groups_destroy_action_path(@group), class: 'btn btn-danger', data: { turbo_confirm: I18n.t('lato_spaces.confirm.group_destroy', name: @group.name, members: @group.lato_spaces_memberships.count, items: @group.lato_spaces_associations.count), turbo_method: :delete } %>
      </div>
    </div>
  </div>
  <div class="card-body">
    <%= render 'layouts/lato_spaces/group-informations_content', group: @group %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h2 class="fs-4 mb-0"><%= I18n.t('lato_spaces.group_members') %></h2>
  </div>
  <div class="card-body">
    <%= lato_index @memberships,
      custom_actions: {
        create: {
          path: lato_spaces.memberships_create_path(@group),
          icon: 'bi bi-plus',
          data: { lato_action_target: 'trigger', turbo_frame: dom_id(LatoSpaces::Membership.new, 'form'), action_title: I18n.t('lato_spaces.new_membership') }
        }
      }
    %>
  </div>
</div>
